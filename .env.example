# =============================================================================
# ENVIRONMENT VARIABLES: Pre-Registration & Participant Data Collection Portal
# =============================================================================

# Frontend Supabase Configuration (Public Anon Key ONLY)
# Never expose the SUPABASE_SERVICE_ROLE_KEY to the browser!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# Optional: Server-Side Privileged Key (Backend / Database Migration ONLY)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
